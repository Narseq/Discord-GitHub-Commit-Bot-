# ---- Discord ----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# ---- Web panel --------------------------------------------------------------
# Port the panel listens on (use the port your host gave you)
PORT=8080

# First panel account. Created ONLY when the accounts table is empty.
# After the first start you can remove PANEL_PASSWORD from this file.
PANEL_USER=admin
PANEL_PASSWORD=

# ---- MySQL (stores the panel accounts) --------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=githubek
MYSQL_PASSWORD=
MYSQL_DATABASE=githubek

# ---- Optional ---------------------------------------------------------------
# GitHub token: raises the API limit from 60 to 5000 requests/hour.
# A classic token with NO scopes is enough for public repositories.
GITHUB_TOKEN=

# Secret used to sign login cookies (defaults to MYSQL_PASSWORD). Any long random string.
SECRET_KEY=

# Interface to listen on (default 0.0.0.0) and path of the local SQLite file (default data.db)
HOST=0.0.0.0
DB_PATH=data.db
